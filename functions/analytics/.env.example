# CORS (optional, comma-separated)
ANALYTICS_ALLOWED_ORIGINS=https://racoondevs.com,https://www.racoondevs.com

# CRM sync target
CRM_SYNC_ENABLED=true
# For analytics we keep this false by default to avoid breaking UX if CRM is down.
CRM_SYNC_REQUIRED=false
CRM_SYNC_ENDPOINT=https://appwrite.racoondevs.com/v1
CRM_SYNC_PROJECT_ID=crm
CRM_SYNC_FUNCTION_ID=track-analytics-event
# Optional API key for cross-project execution (set as secret runtime var if used)
CRM_SYNC_API_KEY=
