# reCAPTCHA
RECAPTCHA_SECRET_KEY=

# Email service: smtp | gmail | sendgrid | console
EMAIL_SERVICE=console

# SMTP config
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Gmail (use App Password, not regular password)
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your-app-password

# SendGrid
# SENDGRID_API_KEY=

# Email addresses
EMAIL_FROM=noreply@racoondevs.com
EMAIL_TO=admin@racoondevs.com

# CORS
CONTACT_ALLOWED_ORIGINS=

# Send confirmation email to client (true/false)
WIZARD_SEND_CLIENT_CONFIRMATION=true

# CRM sync to external Appwrite project (this function runtime)
# Enable/disable CRM sync call
CRM_SYNC_ENABLED=true
# If true, fail request when CRM sync is not available
CRM_SYNC_REQUIRED=true
# Endpoint Appwrite API for CRM project (include /v1 or it will be normalized)
CRM_SYNC_ENDPOINT=https://appwrite.racoondevs.com/v1
# Target CRM Appwrite project ID
CRM_SYNC_PROJECT_ID=crm
# Target CRM Function ID that receives lead payload
CRM_SYNC_FUNCTION_ID=create-lead
# Optional API key for cross-project execution (recommended as secret runtime var)
CRM_SYNC_API_KEY=
