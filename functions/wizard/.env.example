# reCAPTCHA
RECAPTCHA_SECRET_KEY=

# Email service: smtp | gmail | sendgrid | console
EMAIL_SERVICE=console

# SMTP config
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# Gmail (use App Password, not regular password)
# EMAIL_USER=your@gmail.com
# EMAIL_PASS=your-app-password

# SendGrid
# SENDGRID_API_KEY=

# Email addresses
EMAIL_FROM=noreply@racoondevs.com
EMAIL_TO=admin@racoondevs.com

# CORS
CONTACT_ALLOWED_ORIGINS=

# Send confirmation email to client (true/false)
WIZARD_SEND_CLIENT_CONFIRMATION=true
