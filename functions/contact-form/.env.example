# ==============================================================================
# RACOONDEVS CONTACT FORM - VARIABLES DE ENTORNO
# ==============================================================================
# Copia este archivo como .env y configura los valores reales.
# Estas variables deben configurarse en Appwrite > Functions > tu-funcion > Settings > Variables

# ==============================================================================
# reCAPTCHA v3 (Obligatorio)
# ==============================================================================
# Obtén tu secret key en: https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=tu-recaptcha-secret-key

# ==============================================================================
# CONFIGURACIÓN DE EMAIL (Obligatorio)
# ==============================================================================
# Servicio de email: smtp | gmail | sendgrid | console
# - smtp: Servidor SMTP personalizado (ej: mail.tudominio.com)
# - gmail: Usar Gmail (requiere App Password)
# - sendgrid: Usar SendGrid API
# - console: Solo imprime en logs (para desarrollo/testing)
EMAIL_SERVICE=smtp

# ==============================================================================
# SMTP (si EMAIL_SERVICE=smtp)
# ==============================================================================
SMTP_HOST=mail.racoondevs.com
SMTP_PORT=587
# Usar TLS: true para puerto 465, false para 587 con STARTTLS
SMTP_SECURE=false

# ==============================================================================
# CREDENCIALES DE EMAIL (Obligatorio)
# ==============================================================================
# Para Gmail: usar App Password (https://myaccount.google.com/apppasswords)
# Para SendGrid: dejar EMAIL_USER vacío y usar SENDGRID_API_KEY
EMAIL_USER=noreply@racoondevs.com
EMAIL_PASS=tu-password-de-email

# ==============================================================================
# SENDGRID (si EMAIL_SERVICE=sendgrid)
# ==============================================================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# DIRECCIONES DE EMAIL
# ==============================================================================
# Remitente de los correos
EMAIL_FROM=noreply@racoondevs.com
# Donde recibes los leads/contactos
EMAIL_TO=admin@racoondevs.com

# ==============================================================================
# CORS - ORÍGENES PERMITIDOS (Recomendado)
# ==============================================================================
# Lista de dominios permitidos separados por coma.
# Dejar vacío para permitir cualquier origen (no recomendado en producción).
CONTACT_ALLOWED_ORIGINS=https://racoondevs.com,https://www.racoondevs.com

# ==============================================================================
# OPCIONALES
# ==============================================================================
# Enviar email de confirmación al cliente (true/false, default: true)
CONTACT_SEND_CLIENT_CONFIRMATION=true

# ==============================================================================
# CRM SYNC (LEADS HACIA PROYECTO crm)
# ==============================================================================
# Habilita/deshabilita sincronizacion de lead al CRM
CRM_SYNC_ENABLED=true
# Si es true, falla la request cuando CRM sync no esta disponible
CRM_SYNC_REQUIRED=true
# Endpoint Appwrite API del proyecto CRM (con /v1 o sin /v1)
CRM_SYNC_ENDPOINT=https://appwrite.racoondevs.com/v1
# Project ID del CRM
CRM_SYNC_PROJECT_ID=crm
# Function ID destino en CRM (ingesta de leads)
CRM_SYNC_FUNCTION_ID=create-lead
# API key opcional para ejecucion cross-project (configurar como secret en runtime)
CRM_SYNC_API_KEY=
