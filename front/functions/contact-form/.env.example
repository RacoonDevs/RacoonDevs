# Required
RECAPTCHA_SECRET_KEY=

# Email provider: smtp | gmail | sendgrid | console
EMAIL_SERVICE=smtp

# SMTP / Gmail
SMTP_HOST=smtp.ionos.mx
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=admin@racoondevs.com
EMAIL_TO=admin@racoondevs.com

# SendGrid (ONLY if EMAIL_SERVICE=sendgrid)
# Create it in SendGrid Dashboard > Settings > API Keys
SENDGRID_API_KEY=

# Appwrite server API key (OPTIONAL)
# Only needed if this function will call Appwrite services via SDK
# Example scopes: databases.read, databases.write, users.read, messages.write
APPWRITE_API_KEY=

# Security
# Comma-separated list, example: https://racoondevs.com,https://www.racoondevs.com
CONTACT_ALLOWED_ORIGINS=

# If false, only team email is sent
CONTACT_SEND_CLIENT_CONFIRMATION=true
